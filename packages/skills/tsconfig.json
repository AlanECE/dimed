{
	"compilerOptions": {
		"target": "ES2017",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": true,
		"esModuleInterop": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
